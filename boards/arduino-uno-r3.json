  "rules": {
    "datasheet": "ATmega328P datasheet",
    "i2c": {
      "sda": "A4",
      "scl": "A5",
      "remappable": false,
      "note": "I2C only works on A4 (SDA) and A5 (SCL); the SDA/SCL pins near AREF are the same signals."
    },
    "spi": {
      "mosi": "D11",
      "miso": "D12",
      "sck": "D13",
      "cs": "D10"
    },
