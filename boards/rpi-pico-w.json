    "datasheet": "RP2040 datasheet",
    "i2c": {
      "sda": "GP4",
      "scl": "GP5",
      "remappable": false,
      "note": "Only certain pin pairs can be I2C on this chip, and SDA and SCL cannot be swapped in software. Wire uses GP4 (SDA) and GP5 (SCL); Wire.setSDA()/Wire.setSCL() before Wire.begin() can move I2C0 to GP0/GP1, GP8/GP9, GP12/GP13, GP16/GP17 or GP20/GP21. Wire1 defaults to GP26/GP27."
    },
    "spi": {
      "mosi": "GP19",
      "miso": "GP16",
