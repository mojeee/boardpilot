{
  "id": "mpu6500",
  "name": "MPU6500 (GY-6500) accelerometer + gyro",
  "category": "sensor",
  "measures": [
    "acceleration",
    "rotation",
    "temperature"
  ],
  "pins": [
    {
      "name": "VCC",
      "role": "power"
    },
    {
      "name": "GND",
      "role": "ground"
    },
    {
      "name": "SCL",
      "role": "i2c_scl"
    },
    {
      "name": "SDA",
      "role": "i2c_sda"
    },
    {
      "name": "EDA",
      "role": "passive",
      "notes": "Auxiliary I2C data. Leave unconnected"
    },
    {
      "name": "ECL",
      "role": "passive",
      "notes": "Auxiliary I2C clock. Leave unconnected"
    },
    {
      "name": "AD0",
      "role": "passive",
      "notes": "Address select: LOW = 0x68, HIGH = 0x69"
    },
    {
      "name": "INT",
      "role": "int"
    },
    {
      "name": "NCS",
      "role": "passive",
      "notes": "SPI chip select. Leave unconnected or HIGH for I2C"
    },
    {
      "name": "FSYNC",
      "role": "passive",
      "notes": "Frame sync. Leave unconnected or tie to GND"
    }
  ],
  "bus": "i2c",
  "addresses": [
    "0x68",
    "0x69"
  ],
  "idCheck": {
    "register": "0x75",
    "expect": "0x70"
  },
  "voltage": "3.3-5",
  "pullupsOnBoard": true,
  "model": {
    "shape": "breakout",
    "size": [
      26.4,
      15.5,
      1.6
    ],
    "color": "#5B2A86"
  },
  "keywords": [
    "mpu6500",
    "gy-6500",
    "imu",
    "accelerometer",
    "gyro",
    "giroscopio",
    "accelerometro"
  ],
  "sources": [
