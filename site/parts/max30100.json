{
  "id": "max30100",
  "name": "MAX30100 heart rate + SpO2",
  "category": "sensor",
  "measures": [
    "heart rate",
    "blood oxygen"
  ],
  "pins": [
    {
      "name": "VIN",
      "role": "power"
    },
    {
      "name": "SCL",
      "role": "i2c_scl",
      "notes": "Many purple boards pull SCL up to 1.8 V only: the ESP32 may not read it"
    },
    {
      "name": "SDA",
      "role": "i2c_sda",
      "notes": "Many purple boards pull SDA up to 1.8 V only: the ESP32 may not read it"
    },
    {
      "name": "INT",
      "role": "int",
      "notes": "Interrupt output, optional"
    },
    {
      "name": "IRD",
      "role": "passive",
      "notes": "IR LED output. Leave unconnected"
    },
    {
      "name": "RD",
      "role": "passive",
      "notes": "Red LED output. Leave unconnected"
    },
    {
      "name": "GND",
      "role": "ground"
    }
  ],
  "bus": "i2c",
  "addresses": [
    "0x57"
  ],
  "idCheck": {
    "register": "0xFF",
    "expect": "0x11"
  },
  "voltage": "3.3-5",
  "pullupsOnBoard": true,
  "model": {
    "shape": "breakout",
    "size": [
      19,
      14,
      1.6
    ],
    "color": "#5B2A86"
  },
  "keywords": [
    "max30100",
    "gy-max30100",
    "rcwl-0530",
    "heart rate",
    "spo2",
    "oximeter",
    "battito",
    "ossimetro"
  ],
  "sources": [
    {
      "title": "Maxim MAX30100 datasheet",
      "section": "Register 0xFF Part ID (reads 0x11); I2C address 0x57"
    },
    {
      "title": "Maxim MAX30100 datasheet",
      "section": "Chip supply 1.8 V plus 3.3 V for the LEDs; boards regulate both"
    }
  ]
}