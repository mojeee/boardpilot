{
  "id": "ina3221",
  "name": "INA3221 3-channel current + voltage monitor",
  "category": "sensor",
  "measures": [
    "current",
    "voltage",
    "power"
  ],
  "pins": [
    {
      "name": "VS",
      "role": "power",
      "notes": "Pin order differs between boards: check the silkscreen"
    },
    {
      "name": "GND",
      "role": "ground"
    },
    {
      "name": "SCL",
      "role": "i2c_scl"
    },
    {
      "name": "SDA",
      "role": "i2c_sda"
    },
    {
      "name": "WAR",
      "role": "int",
      "notes": "Warning alert, open drain. Optional"
    },
    {
      "name": "CRI",
      "role": "int",
      "notes": "Critical alert, open drain. Optional"
    },
    {
      "name": "TC",
      "role": "passive",
      "notes": "Timing control alert. Leave unconnected"
    },
    {
      "name": "PV",
      "role": "passive",
      "notes": "Power valid alert. Leave unconnected"
    },
    {
      "name": "IN1+",
      "role": "passive",
      "notes": "Channel 1 from the supply. Measured circuit only, up to 26 V"
    },
    {
      "name": "IN1-",
      "role": "passive",
      "notes": "Channel 1 to the load"
    },
    {
      "name": "IN2+",
      "role": "passive",
      "notes": "Channel 2 from the supply"
    },
    {
      "name": "IN2-",
      "role": "passive",
      "notes": "Channel 2 to the load"
    },
    {
      "name": "IN3+",
      "role": "passive",
      "notes": "Channel 3 from the supply"
    },
    {
      "name": "IN3-",
      "role": "passive",
      "notes": "Channel 3 to the load"
    }
  ],
  "bus": "i2c",
  "addresses": [
    "0x40",
    "0x41",
    "0x42",
    "0x43"
  ],
  "voltage": "3.3-5",
  "pullupsOnBoard": true,
  "model": {
    "shape": "breakout",
    "size": [
      36.6,
      25,
      1.6
    ],
    "color": "#1A1A1A"
  },
  "keywords": [
    "ina3221",
    "current",
    "voltage",
    "3 channel",
    "power monitor",
    "corrente",
    "tensione"
  ],
  "sources": [
