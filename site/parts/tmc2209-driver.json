{
  "id": "tmc2209-driver",
  "name": "TMC2209 silent stepper driver (StepStick)",
  "category": "output",
  "pins": [
    {
      "name": "EN",
      "role": "digital_in",
      "needsOutput": true,
      "notes": "Pin order varies between boards: match by the printed label. Enable, active LOW. Connect to GND to keep it on"
    },
    {
      "name": "MS1",
      "role": "passive",
      "notes": "Microstep select. With UART: address bit 0"
    },
    {
      "name": "MS2",
      "role": "passive",
      "notes": "Microstep select. With UART: address bit 1"
    },
    {
      "name": "UART",
      "role": "passive",
      "notes": "Single-wire UART (optional, via a 1 kΩ resistor for TX)"
    },
    {
      "name": "PDN",
      "role": "passive",
      "notes": "Power down / UART. Leave unconnected for STEP/DIR use"
    },
    {
      "name": "CLK",
      "role": "passive",
      "notes": "Clock input. Connect to GND (internal clock)"
    },
    {
      "name": "STEP",
      "role": "digital_in",
      "needsOutput": true,
      "notes": "One pulse = one (micro)step"
    },
    {
      "name": "DIR",
      "role": "digital_in",
      "needsOutput": true,
      "notes": "Direction"
    },
    {
      "name": "VM",
      "role": "passive",
      "notes": "Motor supply 5.5 to 28 V from a separate supply. Add a 100 µF capacitor"
    },
    {
      "name": "GND_MOT",
      "role": "ground",
      "notes": "Motor supply ground"
    },
    {
      "name": "B2",
      "role": "passive",
      "notes": "Motor coil B"
    },
    {
      "name": "B1",
      "role": "passive",
      "notes": "Motor coil B"
    },
    {
      "name": "A1",
      "role": "passive",
      "notes": "Motor coil A"
    },
    {
      "name": "A2",
      "role": "passive",
      "notes": "Motor coil A"
    },
    {
      "name": "VIO",
      "role": "power",
      "notes": "Logic supply: 3V3"
    },
    {
      "name": "GND",
      "role": "ground"
    },
    {
      "name": "DIAG",
      "role": "digital_out",
      "notes": "Stall / error output (StallGuard). Optional"
    },
    {
      "name": "INDEX",
      "role": "digital_out",
      "notes": "Index pulse output. Optional"
    }
  ],
  "bus": "gpio",
  "voltage": "3.3-5",
  "model": {
    "shape": "module",
    "size": [
      46.7,
      15.2,
      10
    ],
    "color": "#1A1A1A"
  },
  "keywords": [
    "tmc2209",
    "stepper driver",
    "stepstick",
    "silent",
    "stallguard",
    "driver passo passo"
  ],
  "sources": [
    {
      "title": "Trinamic TMC2209 datasheet",
      "section": "VM 4.75 to 29 V; VIO 3 to 5 V; UART address set by MS1/MS2; DIAG, INDEX"
    }
  ]
}