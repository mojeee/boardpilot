  "name": "10 kΩ potentiometer",
  "category": "input",
  "pins": [
    {
      "name": "VCC",
      "role": "power",
      "notes": "Use 3V3, never VIN: the ESP32 ADC must not see more than 3.3 V"
    },
    {
      "name": "OUT",
      "role": "analog_out",
      "notes": "Wiper, to an ADC pin (prefer ADC1: GPIO 32 to 39)"
    },
    {
      "name": "GND",
      "role": "ground"
    }
  ],
  "bus": "analog",
  "voltage": "3.3",
