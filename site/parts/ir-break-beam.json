{
  "id": "ir-break-beam",
  "name": "IR break-beam sensor pair (emitter + receiver)",
  "category": "sensor",
  "measures": [
    "presence"
  ],
  "pins": [
    {
      "name": "TX-VCC",
      "role": "power",
      "notes": "Emitter red wire"
    },
    {
      "name": "TX-GND",
      "role": "ground",
      "notes": "Emitter black wire"
    },
    {
      "name": "RX-VCC",
      "role": "power",
      "notes": "Receiver red wire"
    },
    {
      "name": "RX-GND",
      "role": "ground",
      "notes": "Receiver black wire"
    },
    {
      "name": "OUT",
      "role": "digital_out",
