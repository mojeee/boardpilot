    },
    {
      "name": "GND",
      "role": "ground"
    },
    {
      "name": "SCK",
      "role": "i2c_scl",
      "notes": "I2C SCL (SPI SCK)"
    },
    {
      "name": "SDO",
      "role": "passive",
      "notes": "I2C address select: LOW = 0x76, HIGH or open = 0x77"
    },
    {
      "name": "SDI",
      "role": "i2c_sda",
      "notes": "I2C SDA (SPI SDI)"
    },
    {
      "name": "CS",
      "role": "passive",
      "notes": "Leave HIGH or unconnected for I2C"
    },
    {
      "name": "INT",
      "role": "int",
      "notes": "Interrupt output, optional"
    }
  ],
  "bus": "i2c",
  "addresses": [
