{
  "id": "adxl345-gy291",
  "name": "GY-291 ADXL345 accelerometer",
  "category": "sensor",
  "measures": [
    "acceleration"
  ],
  "pins": [
    {
      "name": "GND",
      "role": "ground"
    },
    {
      "name": "VCC",
      "role": "power"
    },
    {
      "name": "CS",
      "role": "passive",
      "notes": "HIGH (default on the board) selects I2C"
    },
    {
      "name": "INT1",
      "role": "int"
    },
    {
      "name": "INT2",
      "role": "int"
    },
    {
      "name": "SDO",
      "role": "passive",
      "notes": "Address select: LOW = 0x53, HIGH = 0x1D"
    },
    {
      "name": "SDA",
      "role": "i2c_sda"
    },
    {
      "name": "SCL",
      "role": "i2c_scl"
    }
  ],
  "bus": "i2c",
  "addresses": [
    "0x53",
    "0x1D"
  ],
  "idCheck": {
