  "model": {
    "shape": "breakout",
    "size": [
      21.3,
      15.7,
      1.6
    ],
    "color": "#5B2A86"
  },
  "keywords": [
    "adxl345",
    "gy-291",
    "accelerometer",
    "tilt",
    "acceleration",
    "accelerometro"
  ],
  "sources": [
    {
      "title": "Analog Devices ADXL345 datasheet",
      "section": "Register 0x00 DEVID (reads 0xE5)"
