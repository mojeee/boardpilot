{
  "id": "adxl375",
  "name": "ADXL375 high-g accelerometer (±200 g)",
  "category": "sensor",
  "measures": [
    "acceleration"
  ],
  "pins": [
    {
      "name": "VIN",
      "role": "power"
    },
    {
      "name": "3VO",
      "role": "passive",
      "notes": "Output of the on-board 3.3 V regulator. Leave unconnected"
    },
    {
      "name": "GND",
      "role": "ground"
    },
    {
      "name": "SCL",
      "role": "i2c_scl"
    },
    {
      "name": "SDA",
      "role": "i2c_sda"
    },
    {
      "name": "SDO",
      "role": "passive",
      "notes": "Address select: LOW = 0x53, HIGH = 0x1D"
    },
    {
      "name": "CS",
      "role": "passive",
      "notes": "SPI chip select. Leave unconnected or HIGH for I2C"
    },
    {
      "name": "INT1",
      "role": "int",
      "notes": "Interrupt output, optional"
    },
    {
      "name": "INT2",
      "role": "int",
      "notes": "Interrupt output, optional"
    }
  ],
  "bus": "i2c",
  "addresses": [
    "0x53",
    "0x1D"
  ],
  "idCheck": {
    "register": "0x00",
    "expect": "0xe5"
  },
  "voltage": "3.3-5",
  "pullupsOnBoard": true,
  "model": {
    "shape": "breakout",
    "size": [
      25.4,
      17.8,
      1.6
    ],
    "color": "#1A1A1A"
  },
  "keywords": [
    "adxl375",
    "high g",
    "shock",
    "impact",
    "accelerometer",
    "urto",
    "accelerometro"
  ],
  "sources": [
    {
      "title": "Analog Devices ADXL375 datasheet",
      "section": "Register 0x00 DEVID (reads 0xE5, same value as ADXL345)"
    },
    {
      "title": "Analog Devices ADXL375 datasheet",
      "section": "I2C address 0x53 (ALT ADDRESS LOW) / 0x1D (HIGH)"
    }
  ]
}