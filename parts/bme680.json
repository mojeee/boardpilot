{
  "id": "bme680",
  "name": "BME680 gas + temperature + humidity + pressure",
  "category": "sensor",
  "measures": ["temperature","humidity","pressure","gas"],
  "pins": [
    { "name": "VCC", "role": "power" },
    { "name": "GND", "role": "ground" },
    { "name": "SCL", "role": "i2c_scl" },
    { "name": "SDA", "role": "i2c_sda" },
    { "name": "SDO", "role": "passive", "notes": "Address select: LOW = 0x76, HIGH = 0x77" },
    { "name": "CS", "role": "passive", "notes": "Leave HIGH or unconnected for I2C" }
  ],
  "bus": "i2c",
  "addresses": ["0x76", "0x77"],
  "idCheck": { "register": "0xD0", "expect": "0x61" },
  "voltage": "3.3",
  "pullupsOnBoard": true,
  "model": { "shape": "breakout", "size": [16.2, 13, 1.6], "color": "#5B2A86" },
  "keywords": ["bme680", "gas", "air quality", "voc", "humidity", "pressure", "bosch", "qualità aria"],
  "sources": [
    { "title": "Bosch BME680 datasheet", "section": "Register 0xD0 chip_id (reads 0x61)" },
    { "title": "Bosch BME680 datasheet", "section": "I2C interface: SDO pin selects address 0x76 / 0x77" }
  ]
}
