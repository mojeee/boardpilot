{
  "id": "hdc1080",
  "name": "HDC1080 temperature + humidity (CJMCU-1080)",
  "category": "sensor",
  "measures": ["temperature", "humidity"],
  "pins": [
    { "name": "VCC", "role": "power", "notes": "Chip accepts 2.7 to 5.5 V. Use 3V3 so the on-board pull-ups stay at 3.3 V" },
    { "name": "GND", "role": "ground" },
    { "name": "SCL", "role": "i2c_scl" },
    { "name": "SDA", "role": "i2c_sda" }
  ],
  "bus": "i2c",
  "addresses": ["0x40"],
  "idCheck": { "register": "0xFF", "expect": "0x10" },
  "voltage": "3.3",
  "pullupsOnBoard": true,
  "model": { "shape": "breakout", "size": [15, 12, 1.6], "color": "#5B2A86" },
  "keywords": ["hdc1080", "cjmcu-1080", "texas instruments", "humidity", "temperature", "umidità", "temperatura"],
  "sources": [
    { "title": "TI HDC1080 datasheet", "section": "I2C address 0x40 (fixed)" },
    { "title": "TI HDC1080 datasheet", "section": "Register map: 0xFF Device ID = 0x1050 (first byte read is 0x10)" },
    { "title": "TI HDC1080 datasheet", "section": "Supply 2.7 to 5.5 V" }
  ]
}
