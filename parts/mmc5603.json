{
  "id": "mmc5603",
  "name": "MMC5603 3-axis magnetometer",
  "category": "sensor",
  "measures": ["magnetic field", "heading", "temperature"],
  "pins": [
    { "name": "VIN", "role": "power" },
    { "name": "3VO", "role": "passive", "notes": "Output of the on-board 3.3 V regulator. Leave unconnected" },
    { "name": "GND", "role": "ground" },
    { "name": "SCL", "role": "i2c_scl" },
    { "name": "SDA", "role": "i2c_sda" }
  ],
  "bus": "i2c",
  "addresses": ["0x30"],
  "idCheck": { "register": "0x39", "expect": "0x10" },
  "voltage": "3.3-5",
  "pullupsOnBoard": true,
  "model": { "shape": "breakout", "size": [25.4,17.8,1.6], "color": "#1A1A1A" },
  "keywords": ["mmc5603", "memsic", "magnetometer", "compass", "bussola", "magnetometro"],
  "sources": [
    { "title": "MEMSIC MMC5603NJ datasheet", "section": "Register 0x39 Product ID (reads 0x10)" },
    { "title": "MEMSIC MMC5603NJ datasheet", "section": "Fixed I2C address 0x30" }
  ]
}
