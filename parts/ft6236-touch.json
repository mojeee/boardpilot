{
  "id": "ft6236-touch",
  "name": "FT6236 capacitive touch controller (I2C)",
  "category": "input",
  "measures": ["touch position"],
  "pins": [
    { "name": "VCC", "role": "power" },
    { "name": "GND", "role": "ground" },
    { "name": "SCL", "role": "i2c_scl" },
    { "name": "SDA", "role": "i2c_sda" },
    { "name": "INT", "role": "int", "notes": "Interrupt to your board when a touch is ready" },
    { "name": "RST", "role": "digital_in", "needsOutput": true, "notes": "Reset of the touch controller: pulse it LOW at start" }
  ],
  "bus": "i2c",
  "addresses": ["0x38"],
  "idCheck": { "register": "0xA8", "expect": "0x11" },
  "voltage": "3.3",
  "model": {
    "shape": "breakout", "size": [20, 24, 1.6], "color": "#1F4FA8", "silk": "FT6236",
    "components": [{ "type": "chip", "at": [0, 1], "size": [4, 4, 0.9], "package": "qfn", "label": "FT6236" }]
  },
  "gotchas": [
    { "text": "The address is always 0x38 and cannot be changed. Another I2C part at 0x38 (a PCF8574A, for example) clashes with it.", "source": { "title": "Adafruit_FT6206 library", "section": "Adafruit_FT6206.h: FT62XX_DEFAULT_ADDR 0x38" } },
    { "text": "Register 0xA8 reads 0x11 on a working chip. Libraries stop at start-up when it does not, so a wrong value there means a wiring or reset problem, or another chip.", "source": { "title": "Adafruit_FT6206 library", "section": "Adafruit_FT6206.cpp begin(): vendor ID register 0xA8" } }
  ],
  "keywords": ["ft6236", "ft6206", "ft6336", "ft6x36", "capacitive touch", "touch screen", "touchscreen", "tft touch", "tocco capacitivo"],
  "sources": [
    { "title": "Adafruit_FT6206 library", "section": "Adafruit_FT6206.h: address 0x38, vendor ID register 0xA8 = 0x11" },
    { "title": "FocalTech FT6236 datasheet", "section": "I2C interface" }
  ]
}
