{
  "id": "lis3mdl",
  "name": "LIS3MDL 3-axis magnetometer",
  "category": "sensor",
  "measures": ["magnetic field", "heading"],
  "pins": [
    { "name": "VIN", "role": "power" },
    { "name": "3VO", "role": "passive", "notes": "Output of the on-board 3.3 V regulator. Leave unconnected" },
    { "name": "GND", "role": "ground" },
    { "name": "SCL", "role": "i2c_scl" },
    { "name": "SDA", "role": "i2c_sda" },
    { "name": "DO", "role": "passive", "notes": "Address select (SDO): LOW = 0x1C, HIGH = 0x1E" },
    { "name": "CS", "role": "passive", "notes": "SPI chip select. Leave unconnected or HIGH for I2C" },
    { "name": "INT", "role": "int", "notes": "Interrupt output, optional" },
    { "name": "DRDY", "role": "int", "notes": "Data ready, optional" }
  ],
  "bus": "i2c",
  "addresses": ["0x1C", "0x1E"],
  "idCheck": { "register": "0x0F", "expect": "0x3d" },
  "voltage": "3.3-5",
  "pullupsOnBoard": true,
  "model": { "shape": "breakout", "size": [25.4,17.8,1.6], "color": "#1A1A1A" },
  "keywords": ["lis3mdl", "st", "magnetometer", "compass", "bussola", "magnetometro"],
  "sources": [
    { "title": "ST LIS3MDL datasheet", "section": "Register 0x0F WHO_AM_I (reads 0x3D)" },
    { "title": "ST LIS3MDL datasheet", "section": "I2C address 0x1C (SDO/SA1 LOW) / 0x1E (HIGH)" }
  ]
}
