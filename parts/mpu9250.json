{
  "id": "mpu9250",
  "name": "MPU9250 (GY-9250) 9-axis IMU",
  "category": "sensor",
  "measures": ["acceleration","rotation","magnetic field"],
  "pins": [
    { "name": "VCC", "role": "power" },
    { "name": "GND", "role": "ground" },
    { "name": "SCL", "role": "i2c_scl" },
    { "name": "SDA", "role": "i2c_sda" },
    { "name": "EDA", "role": "passive", "notes": "Auxiliary I2C data. Leave unconnected" },
    { "name": "ECL", "role": "passive", "notes": "Auxiliary I2C clock. Leave unconnected" },
    { "name": "AD0", "role": "passive", "notes": "Address select: LOW = 0x68, HIGH = 0x69" },
    { "name": "INT", "role": "int" },
    { "name": "NCS", "role": "passive", "notes": "SPI chip select. Leave unconnected (HIGH) for I2C" },
    { "name": "FSYNC", "role": "passive", "notes": "Frame sync. Leave unconnected or tie to GND" }
  ],
  "bus": "i2c",
  "addresses": ["0x68", "0x69"],
  "idCheck": { "register": "0x75", "expect": "0x71", "otherValues": {"0x70": "This is an MPU6500: it has no magnetometer."} },
  "voltage": "3.3-5",
  "pullupsOnBoard": true,
  "model": { "shape": "breakout", "size": [26.4, 15.5, 1.6], "color": "#5B2A86" },
  "keywords": ["mpu9250", "gy-9250", "imu", "9dof", "accelerometer", "gyro", "magnetometer", "giroscopio"],
  "sources": [
    { "title": "InvenSense MPU-9250 Register Map", "section": "Register 117 WHO_AM_I (reads 0x71)" },
    { "title": "InvenSense MPU-9250 Product Specification", "section": "I2C address 0x68 / 0x69 with AD0" }
  ]
}
