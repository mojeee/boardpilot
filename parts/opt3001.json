{
  "id": "opt3001",
  "name": "OPT3001 ambient light (CJMCU-3001)",
  "category": "sensor",
  "measures": ["light"],
  "pins": [
    { "name": "VCC", "role": "power", "notes": "Chip maximum is 3.6 V: use 3V3 only" },
