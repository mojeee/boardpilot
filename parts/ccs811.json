{
  "id": "ccs811",
  "name": "CCS811 eCO2 + TVOC (CJMCU-811)",
  "category": "sensor",
  "measures": ["eco2","tvoc"],
  "pins": [
    { "name": "VCC", "role": "power" },
    { "name": "GND", "role": "ground" },
    { "name": "SCL", "role": "i2c_scl" },
    { "name": "SDA", "role": "i2c_sda" },
    { "name": "WAK", "role": "digital_in", "needsOutput": true,"notes": "Wake, active LOW. Tie to GND to keep it awake" },
    { "name": "INT", "role": "int", "notes": "Interrupt output, optional" },
    { "name": "RST", "role": "digital_in", "needsOutput": true,"notes": "Reset, active LOW. Optional" },
    { "name": "ADD", "role": "passive", "notes": "Address select: LOW = 0x5A, HIGH = 0x5B" }
  ],
  "bus": "i2c",
  "addresses": ["0x5A", "0x5B"],
  "idCheck": { "register": "0x20", "expect": "0x81" },
