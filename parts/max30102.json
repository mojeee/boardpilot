{
  "id": "max30102",
  "name": "MAX30102 heart rate + SpO2",
  "category": "sensor",
  "measures": ["heart rate","blood oxygen"],
  "pins": [
    { "name": "VIN", "role": "power" },
    { "name": "SDA", "role": "i2c_sda" },
    { "name": "SCL", "role": "i2c_scl" },
    { "name": "INT", "role": "int" },
    { "name": "IRD", "role": "passive", "notes": "IR LED output. Leave unconnected" },
    { "name": "RD", "role": "passive", "notes": "Red LED output. Leave unconnected" },
    { "name": "GND", "role": "ground" }
  ],
  "bus": "i2c",
  "addresses": ["0x57"],
  "idCheck": { "register": "0xFF", "expect": "0x15" },
  "voltage": "3.3-5",
  "pullupsOnBoard": true,
  "model": { "shape": "breakout", "size": [20, 15, 1.6], "color": "#5B2A86" },
  "keywords": ["max30102", "max30100", "heart rate", "pulse", "spo2", "oximeter", "battito", "ossimetro"],
  "sources": [
    { "title": "Maxim MAX30102 datasheet", "section": "Register 0xFF Part ID (reads 0x15)" },
    { "title": "Maxim MAX30102 datasheet", "section": "I2C address 0x57 (0xAE write / 0xAF read)" }
  ]
}
