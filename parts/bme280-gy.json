{
  "id": "bme280-gy",
  "name": "GY-BME280 breakout",
  "category": "sensor",
  "measures": ["temperature", "humidity", "pressure"],
  "pins": [
    { "name": "VIN", "role": "power" },
    { "name": "GND", "role": "ground" },
    { "name": "SCL", "role": "i2c_scl" },
    { "name": "SDA", "role": "i2c_sda" }
  ],
  "bus": "i2c",
  "addresses": ["0x76", "0x77"],
  "idCheck": {
    "register": "0xD0",
    "expect": "0x60",
    "otherValues": { "0x58": "This is a BMP280: no humidity sensor. Common mix-up with cheap boards." }
  },
  "voltage": "3.3",
  "pullupsOnBoard": true,
  "model": { "shape": "breakout", "size": [11, 13, 1.6], "color": "#5B2A86" },
  "keywords": ["bme280", "bmp280", "gy-bme280", "temperature", "humidity", "pressure", "barometer", "bosch"],
  "sources": [
    { "title": "Bosch BME280 datasheet", "section": "5.4.1 Register 0xD0 id" },
    { "title": "Bosch BME280 datasheet", "section": "6.2 I2C interface (address 0x76 when SDO = GND, 0x77 when SDO = VDDIO)" },
    { "title": "Bosch BMP280 datasheet", "section": "4.3.1 Register 0xD0 id (0x58)" }
  ],
  "starterSketch": "bme280"
}
