{
  "id": "bmi160",
  "name": "BMI160 (GY-BMI160) accelerometer + gyro",
  "category": "sensor",
  "measures": ["acceleration", "rotation"],
  "pins": [
    { "name": "VIN", "role": "power", "notes": "Goes through the on-board regulator. Pin order differs between sellers" },
    { "name": "3V3", "role": "passive", "notes": "Regulator output. Leave unconnected when you power VIN" },
    { "name": "GND", "role": "ground" },
    { "name": "SCL", "role": "i2c_scl" },
    { "name": "SDA", "role": "i2c_sda" },
    { "name": "CS", "role": "passive", "notes": "SPI chip select. Leave unconnected or HIGH for I2C" },
    { "name": "SAO", "role": "passive", "notes": "Address select (SDO): LOW = 0x68, HIGH = 0x69" }
  ],
  "bus": "i2c",
  "addresses": ["0x68", "0x69"],
  "idCheck": { "register": "0x00", "expect": "0xd1" },
  "voltage": "3.3-5",
  "pullupsOnBoard": true,
  "model": { "shape": "breakout", "size": [20,13,1.6], "color": "#5B2A86" },
  "keywords": ["bmi160", "gy-bmi160", "bosch", "imu", "accelerometer", "gyro", "giroscopio"],
  "sources": [
    { "title": "Bosch BMI160 datasheet", "section": "Register 0x00 CHIP_ID (reads 0xD1)" },
    { "title": "Bosch BMI160 datasheet", "section": "I2C address 0x68 (SDO to GND) / 0x69 (SDO to VDDIO)" }
  ]
}
