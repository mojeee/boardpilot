{
  "id": "lsm6ds3",
  "name": "LSM6DS3 accelerometer + gyro",
  "category": "sensor",
  "measures": ["acceleration","rotation"],
  "pins": [
    { "name": "VIN", "role": "power" },
    { "name": "GND", "role": "ground" },
    { "name": "SCL", "role": "i2c_scl" },
    { "name": "SDA", "role": "i2c_sda" },
    { "name": "SDO", "role": "passive", "notes": "Address select: LOW = 0x6A, HIGH = 0x6B" },
    { "name": "CS", "role": "passive", "notes": "HIGH selects I2C" },
    { "name": "INT1", "role": "int" },
    { "name": "INT2", "role": "int" }
  ],
  "bus": "i2c",
  "addresses": ["0x6A", "0x6B"],
  "idCheck": { "register": "0x0F", "expect": "0x69", "otherValues": {"0x6a": "This is an LSM6DS3TR-C: very similar, use a library that supports it."} },
  "voltage": "3.3",
  "pullupsOnBoard": true,
  "model": { "shape": "breakout", "size": [21.3, 15, 1.6], "color": "#5B2A86" },
  "keywords": ["lsm6ds3", "lsm6ds3tr-c", "imu", "accelerometer", "gyro", "giroscopio"],
  "sources": [
    { "title": "ST LSM6DS3 datasheet", "section": "Register 0x0F WHO_AM_I (reads 0x69)" },
    { "title": "ST LSM6DS3 datasheet", "section": "I2C: SDO/SA0 LOW 0x6A, HIGH 0x6B" }
  ]
}
