{
  "name": "boardpilot",
  "productName": "BoardPilot",
  "version": "0.7.0",
  "description": "Guided embedded software work on a real ESP32 board, with a live 3D view.",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.demo.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:agent": "bash scripts/build-agent.sh",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "build:web": "vite build -c vite.web.config.ts",
    "build:tools": "vite build -c vite.tools.config.ts",
    "build:site": "npm run build:web && npm run build:tools && node scripts/build-site.mjs",
    "motion": "electron-vite build && node scripts/render-motion.mjs",
    "seo:ping": "node scripts/indexnow.mjs",
    "dist:win": "electron-vite build && electron-builder --win",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "build": {
    "appId": "com.agentflowbind.boardpilot",
    "productName": "BoardPilot",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/agent",
        "to": "agent",
        "filter": [
          "**/*.bin",
          "**/*.uf2",
          "**/*.hex",
          "**/manifest.json",
          "index.json"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "BoardPilot-mac-${arch}.${ext}",
      "identity": null
    },
    "dmg": {
      "title": "BoardPilot ${version}"
    },
    "publish": null,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "BoardPilot-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "BoardPilot"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "node-llama-cpp": "^3.22.1",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "uplot": "^1.6.32",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  },
  "author": {
    "name": "Mojtaba Amini",
    "url": "https://github.com/mojeee"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://boardpilot.agentflowbind.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/mojeee/boardpilot.git"
  }
}
